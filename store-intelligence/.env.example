# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/storedb

# Redis
REDIS_URL=redis://localhost:6379

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Pipeline
CLIPS_DIR=/data/clips
LAYOUT_FILE=/data/store_layout.json
OUTPUT_DIR=./events
STORE_ID=STORE_BLR_002

# API
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# RL Tuner
RL_MODEL_PATH=./models/rl_threshold_policy
QUEUE_SPIKE_THRESHOLD_DEFAULT=5
DEAD_ZONE_WINDOW_MINUTES=30
STALE_FEED_THRESHOLD_MINUTES=10
